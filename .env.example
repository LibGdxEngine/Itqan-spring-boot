# Environment Configuration
# Copy this file to .env and update values as needed

# Environment Type (development or production)
ENV=development

# Database Configuration
POSTGRES_DB=itqan_edu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Backend Configuration
BACKEND_PORT=8080

# JWT Configuration
# IMPORTANT: Change JWT_SECRET to a strong, unique value in production (min 32 chars)
JWT_SECRET=itqan-education-platform-secret-key-change-in-production-environment-minimum-256-bits
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Super Admin
APP_SUPER_ADMIN_EMAIL=superadmin@itqan.edu
APP_SUPER_ADMIN_PASSWORD=Admin@123456
APP_SUPER_ADMIN_FIRST_NAME=Super
APP_SUPER_ADMIN_LAST_NAME=Admin

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:3000/courses/success
STRIPE_CANCEL_URL=http://localhost:3000/courses/cancel
STRIPE_CURRENCY=usd

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# WhatsApp numbers for manual payment (Vodafone Cash / InstaPay).
# International format, digits only — no '+', spaces, or leading zero (e.g. 201001234567).
# Read at runtime by /api/payment-config; editing only needs a container recreate, no rebuild.
WHATSAPP_VODAFONE_NUMBER=201001234567
WHATSAPP_INSTAPAY_NUMBER=201001234567

# MinIO / S3-compatible storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_CORS_ALLOW_ORIGIN=*
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend object storage integration
APP_STORAGE_S3_ENDPOINT=http://minio:9000
APP_STORAGE_S3_REGION=us-east-1
APP_STORAGE_S3_ACCESS_KEY=minioadmin
APP_STORAGE_S3_SECRET_KEY=minioadmin
APP_STORAGE_S3_BUCKET=itqan-videos
APP_VIDEO_MAX_SIZE_BYTES=5368709120
APP_VIDEO_MULTIPART_PART_SIZE_BYTES=16777216
APP_VIDEO_PRESIGN_EXPIRY_MINUTES=15
APP_VIDEO_PLAYBACK_URL_EXPIRY_MINUTES=60

# Meilisearch Configuration
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=masterKey123
MEILI_ENV=development
MEILI_PORT=7700

# Site URL (used for SEO: sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JPA Configuration
# Flyway (backend/src/main/resources/db/migration) owns the schema; Hibernate only validates.
# Schema changes = add a new V<n>__description.sql migration, never ddl-auto=update.
JPA_HIBERNATE_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Rate Limiting (per client IP) for login / register / Google sign-in
RATE_LIMIT_AUTH=10

# Account Lockout
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# Spring Profile (set to 'prod' for production to enforce security checks)
SPRING_PROFILES_ACTIVE=default

# Caddy / HTTPS (production only)
# Set DOMAIN to your real domain for automatic Let's Encrypt HTTPS
# e.g., DOMAIN=learn.itqan.edu
DOMAIN=localhost

# pgAdmin Configuration (set ENABLE_PGADMIN=false in production)
ENABLE_PGADMIN=true
PGADMIN_EMAIL=admin@itqan.edu
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Restart Policy (unless-stopped for dev, always for prod)
RESTART_POLICY=unless-stopped

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# Cache
CACHE_TTL_MS=600000

# HikariCP Connection Pool
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000
HIKARI_LEAK_DETECTION=60000

# Backups (run automatically with the prod profile; restore with scripts/db-restore.sh)
BACKUP_RETENTION_DAYS=7
BACKUP_DB_TIME=02:00
BACKUP_FILES_TIME=03:00
# Optional off-site copy of DB dumps + video bucket to any S3-compatible storage
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Monitoring (COMPOSE_PROFILES=prod,monitoring). Generate long random values.
METRICS_SCRAPE_TOKEN=
GRAFANA_ADMIN_PASSWORD=
# METRICS_TARGET=backend-prod:8080   # use backend:8080 with the dev profile

# Error reporting (Sentry). Leave empty to disable. The frontend DSN is baked in at build time.
SENTRY_DSN=
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Logging
LOG_PATH=./logs
