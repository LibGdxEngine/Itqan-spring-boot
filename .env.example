# Environment Configuration
# Copy this file to .env and update values as needed

# Environment Type (development or production)
ENV=development

# Database Configuration
POSTGRES_DB=itqan_edu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Backend Configuration
BACKEND_PORT=8080
JWT_SECRET=itqan-education-platform-secret-key-change-in-production-environment-minimum-256-bits
JWT_EXPIRATION=86400000
APP_SUPER_ADMIN_EMAIL=superadmin@itqan.edu
APP_SUPER_ADMIN_PASSWORD=Admin@123456
APP_SUPER_ADMIN_FIRST_NAME=Super
APP_SUPER_ADMIN_LAST_NAME=Admin
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:3000/courses/success
STRIPE_CANCEL_URL=http://localhost:3000/courses/cancel
STRIPE_CURRENCY=usd

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# MinIO / S3-compatible storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_CORS_ALLOW_ORIGIN=*
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend object storage integration
APP_STORAGE_S3_ENDPOINT=http://minio:9000
APP_STORAGE_S3_REGION=us-east-1
APP_STORAGE_S3_ACCESS_KEY=minioadmin
APP_STORAGE_S3_SECRET_KEY=minioadmin
APP_STORAGE_S3_BUCKET=itqan-videos
APP_VIDEO_MAX_SIZE_BYTES=5368709120
APP_VIDEO_MULTIPART_PART_SIZE_BYTES=16777216
APP_VIDEO_PRESIGN_EXPIRY_MINUTES=15
APP_VIDEO_PLAYBACK_URL_EXPIRY_MINUTES=60

# Meilisearch Configuration
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=masterKey123
MEILI_ENV=development
MEILI_PORT=7700

# Site URL (used for SEO: sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JPA Configuration
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true

# pgAdmin Configuration (set ENABLE_PGADMIN=false in production)
ENABLE_PGADMIN=true
PGADMIN_EMAIL=admin@itqan.edu
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Restart Policy (unless-stopped for dev, always for prod)
RESTART_POLICY=unless-stopped
