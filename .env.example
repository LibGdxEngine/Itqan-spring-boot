# Environment Configuration
# Copy this file to .env and update values as needed

# Environment Type (development or production)
ENV=development

# Database Configuration
POSTGRES_DB=itqan_edu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Backend Configuration
BACKEND_PORT=8080
JWT_SECRET=itqan-education-platform-secret-key-change-in-production-environment-minimum-256-bits
JWT_EXPIRATION=86400000

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JPA Configuration
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true

# pgAdmin Configuration (set ENABLE_PGADMIN=false in production)
ENABLE_PGADMIN=true
PGADMIN_EMAIL=admin@itqan.edu
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Restart Policy (unless-stopped for dev, always for prod)
RESTART_POLICY=unless-stopped
