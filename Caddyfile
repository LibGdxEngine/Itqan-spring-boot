# Caddyfile — Reverse proxy with automatic HTTPS (Let's Encrypt)
# DOMAIN env var must resolve publicly (A/AAAA record) for cert issuance.

{
    email {$CADDY_ACME_EMAIL:admin@xn--kgbei0hva.com}
    servers {
        trusted_proxies static private_ranges
    }
}

# Redirect www to apex
www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN:localhost} {
    # Cloudflare terminates public TLS; Caddy serves the origin with a self-signed
    # cert (Cloudflare SSL/TLS mode = Full). Public Let's Encrypt would fail behind the CF proxy.
    tls internal

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(self), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
        -Server
    }

    # Block actuator from the internet — health/metrics shouldn't be public.
    @actuator path /actuator /actuator/*
    respond @actuator 404

    # Stripe webhook — must come before the generic /api/* handler so the
    # raw body path is handled without surprises.
    handle /api/payments/webhook/* {
        reverse_proxy backend-prod:8080 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}

            # Same restart resilience as /api/* — don't bounce payment
            # webhooks with a 502 during a deploy.
            health_uri /actuator/health/readiness
            health_interval 2s
            health_timeout 2s
            health_status 200
            lb_try_duration 60s
            lb_try_interval 1s
        }
    }

    # MinIO (media files — clips/videos).
    # Path matches the S3 bucket and is proxied UNCHANGED: presigned URLs are
    # SigV4-signed over the literal request path, so any rewrite (e.g. strip_prefix)
    # would change what MinIO re-signs and produce SignatureDoesNotMatch (403).
    # Host is preserved by Caddy's default, matching the signed host.
    handle /itqan-videos/* {
        reverse_proxy minio:9000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # payment-config is a Next.js (frontend) route, NOT a backend endpoint.
    # Must be matched before the generic /api/* handler below, otherwise it
    # proxies to Spring, which 403s the unknown path -> the checkout dialog's
    # Vodafone Cash / InstaPay options receive empty numbers and render disabled.
    handle /api/payment-config {
        reverse_proxy frontend-prod:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }

    # Backend API
    handle /api/* {
        reverse_proxy backend-prod:8080 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}

            # Ride out backend restarts/boot instead of returning 502.
            # readiness is 200/UP only once Spring has bound :8080 and is ready;
            # the aggregate /actuator/health can be 503 from non-critical
            # indicators, so we probe the readiness group specifically.
            health_uri /actuator/health/readiness
            health_interval 2s
            health_timeout 2s
            health_status 200
            lb_try_duration 60s
            lb_try_interval 1s
        }
    }

    # Swagger/OpenAPI — keep, but lock to GET.
    @swagger path /swagger-ui* /v3/api-docs*
    @swagger_get {
        path /swagger-ui* /v3/api-docs*
        method GET HEAD
    }
    handle @swagger_get {
        reverse_proxy backend-prod:8080
    }
    handle @swagger {
        respond "Method Not Allowed" 405
    }

    # Frontend — Next.js (fallback)
    handle {
        reverse_proxy frontend-prod:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }

    log {
        output stdout
        format console
        level INFO
    }
}
